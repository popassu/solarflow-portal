# Sunbeam Innovation Limited
Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS (turn on the free SSL in hPanel first)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Friendly addresses for the staff portal
  RewriteRule ^(portal|login|staff)/?$ /admin/ [R=301,L]
  # Clean verification links (QR codes): /verify, /v/<token>, /v/r/<token>
  RewriteRule ^verify/?$ verify.php [L,QSA]
  RewriteRule ^v/r/([a-f0-9]{48})/?$ verify.php?r=$1 [L]
  RewriteRule ^v/([a-f0-9]{48})/?$ verify.php?t=$1 [L]
  # Block private folders and files
  RewriteRule ^(includes|data)(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known) - [F,L]
  RewriteRule \.(sql|md|log|lock|sqlite|bak|ini)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; media-src 'self' https:; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  Header unset X-Powered-By
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
