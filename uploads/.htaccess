# Uploaded photos and videos only. Nothing in here may run as code.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh
RemoveType .php .phtml .phar
<FilesMatch ".*">
  Require all denied
</FilesMatch>
<FilesMatch "(?i)^[a-z0-9-]+\.(jpe?g|png|webp|mp4|pdf)$">
  Require all granted
</FilesMatch>
AddType video/mp4 .mp4
AddType application/pdf .pdf
